{
  "$id": "rc.schema.v5",
  "title": "CAT OS Reading Comprehension content item, schema v5",
  "description": "Schema v5 = v4 (the full Learning Page) plus the pattern layer of the content engine (content/taxonomy/varc-taxonomy.json). Passages may be short (120 words) to long (900); genres widen to thirty; each passage carries its organising structure, viewpoint count, tone, an eight-dimension difficulty vector and the reasoning patterns it exercises; each question names its ledger skill, patterns, the mistake it targets, a prediction target where prediction is the skill, and a per-question difficulty triple; each distractor names one of thirty-five trap types; the explanation gains expert_notice (what an expert sees in the passage before the options); and a quality block records the adversarial review and the blind solve. v1–v4 files remain valid under their own schemas; versions are appended, never edited. Validation subset: see src/core/content-loader/validator.js.",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "passage",
    "questions",
    "vocabulary",
    "mentor"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 5
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "status",
        "quality_score",
        "genre",
        "difficulty",
        "difficulty_numeric",
        "stage",
        "skills",
        "word_count",
        "question_count",
        "question_types",
        "theme",
        "estimated_time_min",
        "source",
        "date_added",
        "batch_id",
        "prompt_version",
        "reviewer_notes",
        "length_class",
        "structure",
        "viewpoints",
        "tone",
        "difficulty_vector",
        "reasoning_patterns",
        "quality",
        "vocab_extracted"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rc-[0-9]{4}$"
        },
        "type": {
          "const": "rc"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "accepted",
            "rejected",
            "retired"
          ]
        },
        "quality_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "genre": {
          "enum": [
            "philosophy",
            "psychology",
            "economics",
            "sociology",
            "anthropology",
            "history",
            "political-theory",
            "science",
            "technology-ethics",
            "environment",
            "architecture",
            "arts-culture",
            "literature-theory",
            "linguistics",
            "culture",
            "education",
            "law",
            "ethics",
            "media",
            "institutions",
            "human-behaviour",
            "markets",
            "public-policy",
            "scientific-method",
            "intellectual-history",
            "contemporary-society",
            "mathematics-logic",
            "medicine-health",
            "urban-studies",
            "religion-belief"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "difficulty_numeric": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "stage": {
          "enum": [
            "foundation",
            "developing",
            "intermediate",
            "advanced",
            "elite"
          ]
        },
        "skills": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "enum": [
              "main-idea-extraction",
              "inference",
              "tone-detection",
              "argument-tracking",
              "trap-recognition",
              "vocabulary-in-context",
              "structure-mapping",
              "evidence-anchoring",
              "scope-control",
              "qualifier-tracking",
              "reference-tracking",
              "concession-tracking",
              "causal-reasoning",
              "elimination",
