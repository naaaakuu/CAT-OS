          "target_mistake": {
            "type": "string",
            "minLength": 15,
            "description": "The specific mistake this question is built to catch, e.g. \"reading the conceded view in p2 as the author’s\"."
          },
          "prediction_target": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 20,
            "description": "What the learner should be able to say BEFORE seeing the options, or null when the type is not prediction-friendly."
          },
          "difficulty": {
            "type": "object",
            "required": [
              "inference_depth",
              "distractor_similarity",
              "reasoning_depth"
            ],
            "additionalProperties": false,
            "properties": {
              "inference_depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "distractor_similarity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "reasoning_depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          },
