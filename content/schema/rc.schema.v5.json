            "phenomenon_explanation",
            "history_of_an_idea",
            "concession_thesis",
            "problem_diagnosis_prescription",
            "definition_application",
            "narrative_reflection",
            "dialectic",
            "claim_qualification",
            "analogy_driven",
            "question_answer",
            "comparison_contrast"
