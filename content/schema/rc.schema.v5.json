        "quality": {
          "type": "object",
          "required": [
            "status",
            "adversarial_review",
            "blind_solve"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "draft",
                "reviewed",
                "verified"
              ]
            },
            "adversarial_review": {
              "type": "string",
              "minLength": 40,
              "description": "The second pass, written down: which distractor a strong candidate would argue for, and why the key still stands. Never blank on verified content."
            },
            "blind_solve": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "solver",
                "agreed",
                "total"
              ],
              "additionalProperties": false,
              "properties": {
                "solver": {
                  "type": "string",
                  "minLength": 1
                },
                "agreed": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "description": "A fresh reader answered the questions without the key. agreed/total is the agreement; disagreements were adjudicated and the item repaired before verified."
            }
          }
