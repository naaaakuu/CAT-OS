        },
        "viewpoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "How many distinct positions the passage voices."
        },
        "tone": {
          "type": "string",
          "minLength": 3,
          "description": "The author’s attitude in one or two words, e.g. \"measured, sceptical\"."
        },
        "difficulty_vector": {
          "type": "object",
          "required": [
            "lexical",
            "syntactic",
            "abstraction",
            "inference_depth",
            "distractor_similarity",
            "reasoning_depth",
            "structural_ambiguity",
            "time_pressure"
          ],
          "additionalProperties": false,
          "properties": {
            "lexical": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "syntactic": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "abstraction": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "inference_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "distractor_similarity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "reasoning_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "structural_ambiguity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "time_pressure": {
