    "sentences": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "The five sentences in PRESENTATION order, scrambled so that order never signals the answer (Bible §10 step 6). Labels are display identity only.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "outlier": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "description": "The one sentence that cannot enter the core's discourse structure. On topic by design; out of structure by construction."
    },
    "core_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E"
        ]
      },
      "description": "The four core sentences in the author's paragraph order, as presentation labels. Must exclude the outlier and cover every other label exactly once. The Paragraph Builder mode and the reconstruction layer of every explanation run on this."
    },
    "builder": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 20,
          "description": "The construct mode invitation: one line asking the learner to build the four sentence paragraph before judging anything. Construction before elimination (Bible §7 remediation, Recommendation 5)."
        }
      }
    },
    "explanation": {
      "type": "object",
      "required": [
        "spine_note",
        "core_roles",
        "links",
        "violation_named",
        "why_it_breaks",
        "trap_exposed",
        "exclusion_analysis",
        "detection_habit"
      ],
      "additionalProperties": false,
      "description": "The §12 explanation design, in order: reconstruct the core, assign discourse roles and name the ties, name the violated principle and why the outlier cannot attach, expose the trap, and leave one transferable habit.",
      "properties": {
        "spine_note": {
          "type": "string",
          "minLength": 40,
          "description": "§12 layer 1: the core paragraph the four sentences form, its order and its spine (opening, development, close), in plain words."
        },
        "core_roles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "§12 layer 2: one entry per core sentence IN CORE ORDER, naming its discourse role and why it sits where it sits.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "role",
              "why_here"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              },
              "role": {
                "enum": [
                  "topic",
                  "background",
                  "development",
                  "example",
                  "contrast",
                  "concession",
                  "evidence",
                  "cause_effect",
                  "definition",
                  "conclusion",
                  "restatement",
                  "question",
                  "answer"
                ]
              },
              "why_here": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        },
        "links": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "description": "The three joins between consecutive core sentences, each naming the cohesive tie that binds them (Halliday and Hasan taxonomy plus the given new chain, Bible §3). Ties are named so the learner reads structure, not vocabulary.",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "tie",
              "explanation"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              },
              "to": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              },
              "tie": {
                "enum": [
                  "reference",
                  "conjunction",
                  "lexical",
                  "substitution",
                  "ellipsis",
                  "given_new"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "violation_named": {
          "type": "string",
          "minLength": 40,
          "description": "§12 layer 3, first half: the precise structural principle the outlier violates (scope, stance, given new chain, general versus specific, thread, method versus finding), named in this item's own terms."
        },
        "why_it_breaks": {
          "type": "string",
          "minLength": 40,
          "description": "§12 layer 3, second half: WHY the outlier cannot attach. No antecedent for its reference, introduces a dimension nothing else takes up, competes with the nucleus, or answers a question the paragraph never asked."
