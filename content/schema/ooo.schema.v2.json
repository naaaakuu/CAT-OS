            "rejected",
            "retired"
          ]
        },
        "quality_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Rubric score; items below 85 do not ship, and a failed §11 validation gate overrides any score."
        },
        "genre": {
          "enum": [
            "philosophy",
            "psychology",
            "economics",
            "sociology",
            "anthropology",
            "history",
            "political-theory",
            "science",
            "technology-ethics",
            "environment",
            "architecture",
            "arts-culture",
            "literature-theory",
            "linguistics",
            "culture",
            "education",
            "law",
            "ethics",
            "media",
            "institutions",
            "human-behaviour",
            "markets",
            "public-policy",
            "scientific-method",
            "intellectual-history",
            "contemporary-society",
            "mathematics-logic",
            "medicine-health",
            "urban-studies",
            "religion-belief"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "difficulty_numeric": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "tier": {
          "enum": [
            "foundation",
            "easy",
            "medium",
            "advanced",
            "cat",
            "cat-plus",
            "ninety-nine",
            "premium"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "description": "A quiet display name for lists and the Learning Page. Must never hint at the outlier."
        },
        "theme": {
          "type": "string",
          "minLength": 3
        },
        "estimated_time_sec": {
          "type": "integer",
          "minimum": 45,
          "maximum": 240
        },
        "format": {
          "type": "object",
          "required": [
            "sentence_count",
            "response",
            "marking",
            "format_verified"
          ],
          "additionalProperties": false,
          "properties": {
            "sentence_count": {
              "const": 5,
              "description": "Five sentences, stable 2016 to 2025 (Bible §1). Do not conflate with para jumbles, which moved to four."
            },
            "response": {
              "enum": [
                "TITA",
                "MCQ"
              ]
            },
            "marking": {
              "type": "string",
              "minLength": 3,
              "description": "The per cycle convention, for display beside its verification note. Currently +3/0 with no negative marking on TITA."
            },
            "format_verified": {
              "type": "string",
              "minLength": 4,
              "description": "When and against what the format facts were last verified (Bible Recommendation 1). Never present format as timeless fact."
            }
          }
        },
        "spine_type": {
          "enum": [
            "narrative",
            "argument",
            "expository",
            "descriptive"
          ],
          "description": "The core paragraph's spine (Bible §13 core_paragraph.spine_type)."
        },
        "nucleus": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ],
          "description": "Presentation label of the RST nucleus, the core sentence carrying the paragraph's central purpose (Bible §3). Must be a core sentence, never the outlier."
        },
        "violation_type": {
          "enum": [
            "topically_alien",
            "wrong_scope",
            "general_vs_specific",
            "stance_shift",
            "thread_break",
            "method_vs_finding",
            "example_no_claim"
          ],
          "description": "The outlier's crime, from the Bible §4 taxonomy: (a) topically related but structurally alien, (b) right topic at the wrong scope, (c) a definitional or general statement inside a specific narrative, (d) a stance or tone shift, (e) a broken narrative or argument thread, (f) method versus finding, (g) an example that fits no claim."
        },
        "difficulty_vector": {
          "type": "object",
          "required": [
            "topical_overlap",
            "violation_subtlety",
            "violation_locus",
            "abstractness_vocab",
            "length_syntax_load",
            "core_structure_strength",
            "decoy_load"
          ],
          "additionalProperties": false,
          "description": "The Bible §6 vector. topical_overlap is the PRIMARY lever: higher overlap between outlier and core defeats topic matching and makes the item harder.",
          "properties": {
            "topical_overlap": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "violation_subtlety": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "violation_locus": {
              "enum": [
                "local",
                "global",
                "mixed"
              ],
              "description": "Where the outlier fails. Locally smooth but globally alien is the hardest regime (Bible §3, §6)."
            },
            "abstractness_vocab": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "length_syntax_load": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "core_structure_strength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "How strongly cued the core's spine is. Stronger = the outlier stands out more (easier); looser = harder, and below 3 an item risks unfairness (Bible §6 dimension 6)."
            },
            "decoy_load": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "traps": {
          "type": "object",
          "required": [
            "primary",
            "secondary",
            "description"
          ],
          "additionalProperties": false,
          "description": "The two engineered traps (Bible §5). A = a belonging sentence is given a surface feature that screams misfit. B = the true outlier is given strong local hooks so it appears to belong.",
          "properties": {
            "primary": {
              "enum": [
                "A",
                "B",
                "none"
              ]
            },
            "secondary": {
              "enum": [
                "A",
                "B",
                "none"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 10,
              "description": "How the trap is built in this item, for the trap audit. Plain register."
            }
          }
        },
        "cohesion_signals": {
          "type": "object",
          "required": [
            "reference",
            "substitution",
            "ellipsis",
            "conjunction",
            "lexical_overlap"
          ],
          "additionalProperties": false,
          "description": "Which Halliday and Hasan ties bind the core (Bible §3, §13): present or absent per tie. lexical_overlap true also flags the classic camouflage, shared vocabulary masking a missing structural fit.",
          "properties": {
            "reference": {
              "type": "boolean"
            },
            "substitution": {
              "type": "boolean"
            },
            "ellipsis": {
              "type": "boolean"
            },
            "conjunction": {
              "type": "boolean"
            },
            "lexical_overlap": {
              "type": "boolean"
            }
          }
        },
        "dna_traits": {
          "type": "array",
          "minItems": 1,
          "description": "The bounded Reading DNA extension (Bible §8): exactly four new traits, plus two inherited from Para Jumbles, cross referenced rather than duplicated. Do not invent traits beyond these.",
          "items": {
            "enum": [
              "coherence_monitoring",
              "candidate_model_maintenance",
              "relatedness_vs_belonging",
              "ambiguity_tolerance",
              "given_new_tracking",
              "connective_reading"
            ]
          }
        },
        "mission": {
          "enum": [
            "protect_continuity",
            "find_the_branch",
            "track_the_direction",
            "notice_topic_stability",
            "build_before_eliminating",
            "test_the_ties",
            "watch_the_scope",
            "hold_the_purpose"
          ],
          "description": "The one structural reading skill this item foregrounds. Shown as Today's Mission before solving; copy lives in src/core/mentor/ooo-voice.js."
        },
        "validation": {
          "type": "object",
          "required": [
            "uniqueness_of_answer",
            "reconstruction_check",
            "heuristic_adversarial",
            "trap_audit",
            "expert_reviewed"
          ],
          "additionalProperties": false,
          "description": "The Bible §11 gates. An item ships only if every gate holds: exactly one removal yields coherence, the core has a defensible near unique ordering, shallow heuristic solvers do NOT select the answer, and the traps do not create a second defensible answer.",
          "properties": {
            "uniqueness_of_answer": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "reconstruction_check": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "heuristic_adversarial": {
              "enum": [
                "pass",
                "fail"
              ],
              "description": "pass = a solver playing only surface heuristics (topic keywords, tense or tone difference, pronoun or connective presence) does NOT reliably find the answer. Required from the medium tier up (Bible §10)."
            },
            "trap_audit": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "expert_reviewed": {
              "type": "boolean"
            }
          }
        },
        "learning_objective": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "object",
          "required": [
            "publication",
            "url",
            "author",
            "date_accessed",
            "usage_note"
          ],
          "additionalProperties": false,
          "properties": {
            "publication": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
