            "author": {
              "type": [
                "string",
                "null"
              ]
            },
            "date_accessed": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "usage_note": {
              "type": "string",
              "minLength": 1
            }
