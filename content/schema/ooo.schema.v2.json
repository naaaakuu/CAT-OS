        "quality": {
          "type": "object",
          "required": [
            "status",
            "adversarial_review",
            "blind_solve"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "draft",
                "reviewed",
                "verified"
              ]
            },
            "adversarial_review": {
              "type": "string",
              "minLength": 40,
