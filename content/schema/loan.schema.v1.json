{
  "$id": "loan.schema.v1",
  "title": "CAT OS Loanword bundle, schema v1",
  "description": "English words of foreign origin from one source language (the owner's reference list 6 in 99_REFERENCE/, one '# <Language> Words' table per bundle). Generated by tools/build-lexicon.mjs; `word` and `meaning` are transcribed faithfully from the table cells, never invented or paraphrased (whitespace normalised, words lower-cased unless they carry an acronym-style capital). Entry ids are sequential in table order.",
  "type": "object",
  "required": ["schema_version", "meta", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },

    "meta": {
      "type": "object",
      "required": [
        "id", "type", "version", "status", "language", "title",
        "entry_count", "source", "date_added", "batch_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "pattern": "^loan-[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "loan-<language-slug>; the slug is the language name lower-cased with runs of non-alphanumerics collapsed to '-'." },
        "type":     { "const": "loan" },
        "version":  { "type": "integer", "minimum": 1 },
        "status":   { "enum": ["draft", "review", "accepted", "rejected", "retired"] },
        "language": { "type": "string", "minLength": 1,
          "description": "The source section heading minus the word 'Words', e.g. \"German\", \"African Languages\"." },
        "title":    { "type": "string", "minLength": 1 },
        "entry_count": { "type": "integer", "minimum": 1,
          "description": "Must equal entries.length (checked by loanConsistencyIssues)." },
        "source": {
          "type": "object",
          "required": ["publication", "file", "usage_note"],
          "additionalProperties": false,
          "properties": {
            "publication": { "type": "string", "minLength": 1 },
            "file":        { "type": "string", "minLength": 1 },
            "usage_note":  { "type": "string", "minLength": 1 }
          }
        },
        "date_added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "batch_id":   { "type": "string", "pattern": "^batch-loan-[0-9]{3}$" }
      }
    },

    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "word", "meaning"],
        "additionalProperties": false,
        "properties": {
          "id":      { "type": "string", "pattern": "^loan-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}$" },
          "word":    { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
