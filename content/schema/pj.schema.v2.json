            "syntactic_complexity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "reference_density": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "concept_abstractness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "dependency_chain_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "transition_ambiguity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "competing_openings": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "competing_endings": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "lexical_decoys": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "topic_unfamiliarity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "plausible_orderings": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
