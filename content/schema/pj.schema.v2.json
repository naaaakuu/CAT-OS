        },
        "learning_objective": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "object",
          "required": [
            "publication",
            "url",
            "author",
            "date_accessed",
            "usage_note"
          ],
          "additionalProperties": false,
          "properties": {
            "publication": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "author": {
              "type": [
                "string",
                "null"
              ]
            },
            "date_accessed": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
