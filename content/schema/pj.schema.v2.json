            "adversarial_review": {
              "type": "string",
              "minLength": 40,
              "description": "The second pass, written down: which distractor a strong candidate would argue for, and why the key still stands. Never blank on verified content."
            },
            "blind_solve": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "solver",
                "agreed",
                "total"
