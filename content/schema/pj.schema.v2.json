    "sentences": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "description": "In PRESENTATION order — the scrambled order the learner sees. Labels are display identity only; ids never encode the answer.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "text",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 40
          },
          "role": {
            "enum": [
              "topic",
              "background",
              "development",
              "example",
              "contrast",
              "concession",
              "evidence",
              "cause_effect",
              "definition",
              "conclusion",
              "restatement",
              "question",
              "answer"
            ],
            "description": "The sentence's discourse move (Bible §3): nucleus vs satellite roles, named."
          }
        }
      }
    },
    "correct_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E",
          "F"
        ]
      },
      "description": "The unique best order, as presentation labels. Must be a permutation of every label, never the identity order."
    },
    "links": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "Exactly sentence_count − 1 entries, one per consecutive pair of the correct order, each naming the device AND its reliability — signals are taught as hypotheses, never as rules (Bible §4).",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "device",
          "reliability",
          "explanation"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "to": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "device": {
            "enum": [
              "pronoun_reference",
              "demonstrative_reference",
              "former_latter_reference",
              "logical_connector",
              "thematic_development",
              "causal_chain",
              "temporal_marker",
              "contrast_signal",
              "given_new_flow",
              "lexical_bridge",
              "parallel_structure"
            ]
          },
          "reliability": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "required": [
        "macro_pattern_note",
        "movement",
        "tempting_orders",
        "trap_named",
        "solving_habit"
      ],
      "additionalProperties": false,
      "properties": {
        "macro_pattern_note": {
          "type": "string",
          "minLength": 40,
          "description": "Layer 1 (Bible §11): name the discourse structure in plain words before any sentence-level reasoning."
        },
        "movement": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "description": "Layer 2: the author's movement, one entry per sentence IN CORRECT ORDER — why each sentence does what it does, tied to the meaning relation, not just the token.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "why_here"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F"
                ]
              },
              "why_here": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        },
        "tempting_orders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "Layer 3: the most tempting wrong order(s), each walked to the exact point where global coherence breaks, tagged with the trap that makes it tempting (this tag also powers precise Reading-DNA diagnosis).",
          "items": {
            "type": "object",
            "required": [
              "order",
              "trap_type",
              "why_tempting",
              "where_it_breaks"
            ],
            "additionalProperties": false,
            "properties": {
              "order": {
                "type": "string",
                "pattern": "^[A-F]{4,6}$"
              },
              "trap_type": {
                "enum": [
                  "anchor_pair",
                  "competing_opener",
                  "competing_ending",
                  "lexical_decoy",
                  "generic_the",
                  "false_pronoun_binding",
                  "misleading_connective"
                ]
              },
              "why_tempting": {
                "type": "string",
                "minLength": 30
              },
              "where_it_breaks": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        },
        "trap_named": {
          "type": "string",
          "minLength": 40,
          "description": "Layer 4: the trap that was set, named plainly, with the reusable defense — so the learner builds a defense, not a memory of one item."
        },
        "solving_habit": {
          "type": "string",
          "minLength": 30,
          "description": "One transferable habit of strong solvers this item practices, phrased for ANY future jumble. Shown as 'Make it a habit'."
        }
      }
    },
    "mentor": {
      "type": "object",
      "required": [
        "challenge",
        "paragraph_plain",
        "takeaway"
      ],
      "additionalProperties": false,
      "properties": {
        "challenge": {
          "type": "string",
          "minLength": 20,
          "description": "Shown BEFORE solving: one sentence on what will test the solver. No spoilers of the order."
        },
        "paragraph_plain": {
          "type": "string",
          "minLength": 80,
          "description": "What the assembled paragraph actually says, retold in very plain English — so the learner leaves understanding the author, not just the sequence."
        },
        "takeaway": {
          "type": "string",
          "minLength": 20,
          "description": "One memorable sentence to keep."
        }
      }
    }
  }
}
