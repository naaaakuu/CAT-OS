        "tier",
        "title",
        "theme",
        "estimated_time_sec",
        "format",
        "macro_pattern",
        "cohesion_signals",
        "primary_trap",
        "secondary_traps",
        "dna_traits",
        "difficulty_vector",
        "num_plausible_orderings",
        "heuristic_adversarial",
        "nucleus",
        "learning_objective",
        "source",
        "date_added",
        "batch_id",
        "prompt_version",
        "reviewer_notes",
        "reasoning_patterns",
