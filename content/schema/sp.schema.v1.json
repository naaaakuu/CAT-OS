{
  "$id": "sp.schema.v1",
  "title": "CAT OS Sentence Placement content item, schema v1",
  "description": "A paragraph with one sentence removed; the learner places the removed sentence. The paragraph is shown as its remaining sentences in order, numbered 1..n; the options name positions (before sentence 1, after sentence k). Every wrong position is an engineered trap named from the taxonomy's placement_traps; the explanation names the clue before and after the true slot and the discourse patterns that decide it. Validation subset: see src/core/content-loader/validator.js.",
  "type": "object",
  "required": ["schema_version", "meta", "paragraph", "missing", "question", "explanation", "mentor"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["id", "type", "version", "status", "quality_score", "genre", "difficulty", "difficulty_numeric", "tier", "title", "theme", "estimated_time_sec", "clue_types", "primary_trap", "reasoning_patterns", "difficulty_vector", "learning_objective", "source", "date_added", "batch_id", "reviewer_notes", "quality"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^sp-[0-9]{4}$" },
        "type": { "const": "sp" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["draft", "review", "accepted", "rejected", "retired"] },
        "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "genre": { "enum": ["philosophy", "psychology", "economics", "sociology", "anthropology", "history", "political-theory", "science", "technology-ethics", "environment", "architecture", "arts-culture", "literature-theory", "linguistics", "culture", "education", "law", "ethics", "media", "institutions", "human-behaviour", "markets", "public-policy", "scientific-method", "intellectual-history", "contemporary-society", "mathematics-logic", "medicine-health", "urban-studies", "religion-belief"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "difficulty_numeric": { "type": "integer", "minimum": 1, "maximum": 10 },
        "tier": { "enum": ["foundation", "easy", "medium", "advanced", "cat", "cat-plus", "ninety-nine", "premium"] },
        "title": { "type": "string", "minLength": 3 },
        "theme": { "type": "string", "minLength": 3 },
        "estimated_time_sec": { "type": "integer", "minimum": 30, "maximum": 240 },
        "clue_types": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "enum": ["pronoun_ref", "demonstrative", "former_latter", "article_given_new", "connective_explicit", "connective_implicit", "temporal_sequence", "lexical_repetition", "synonym_hypernym", "substitution_ellipsis", "parallelism", "tense_continuity", "stance_continuity"] } },
        "primary_trap": { "enum": ["wrong_reference_target", "local_fit_global_break", "topic_match_function_mismatch", "premature_conclusion", "redundant_restatement", "scope_jump", "contradicts_neighbour", "stance_shift", "wrong_connective", "tense_break", "new_topic_introduced", "right_idea_wrong_position", "summary_where_development_needed", "attractive_generality"] },
        "reasoning_patterns": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "pattern": "^(comp|inf|arg|scope|lang|struct|elim|meta|disc|sum|word|cr)\\.[a-z_]+$" } },
        "difficulty_vector": {
          "type": "object",
          "required": ["reference_density", "transition_ambiguity", "competing_slots", "concept_abstractness", "syntactic_complexity"],
          "additionalProperties": false,
          "properties": {
            "reference_density": { "type": "integer", "minimum": 1, "maximum": 5 },
            "transition_ambiguity": { "type": "integer", "minimum": 1, "maximum": 5 },
            "competing_slots": { "type": "integer", "minimum": 1, "maximum": 5 },
            "concept_abstractness": { "type": "integer", "minimum": 1, "maximum": 5 },
            "syntactic_complexity": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "learning_objective": { "type": "string", "minLength": 10 },
        "source": {
          "type": "object",
          "required": ["publication", "usage_note"],
          "additionalProperties": false,
          "properties": {
            "publication": { "type": "string", "minLength": 1 },
            "url": { "type": ["string", "null"] },
            "author": { "type": ["string", "null"] },
            "date_accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "usage_note": { "type": "string", "minLength": 1 }
          }
        },
        "date_added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "batch_id": { "type": "string", "pattern": "^batch-sp-[0-9]{3}$" },
        "reviewer_notes": { "type": "string" },
        "quality": {
          "type": "object",
          "required": ["status", "adversarial_review", "blind_solve"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["draft", "reviewed", "verified"] },
            "adversarial_review": { "type": "string", "minLength": 40 },
            "blind_solve": {
              "type": ["object", "null"],
              "required": ["solver", "agreed", "total"],
              "additionalProperties": false,
              "properties": { "solver": { "type": "string", "minLength": 1 }, "agreed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 }, "notes": { "type": "string" } }
            }
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "required": ["sentences"],
      "additionalProperties": false,
      "properties": {
        "sentences": {
          "type": "array", "minItems": 3, "maxItems": 6,
          "items": { "type": "object", "required": ["n", "text"], "additionalProperties": false,
            "properties": { "n": { "type": "integer", "minimum": 1, "maximum": 6 }, "text": { "type": "string", "minLength": 20 } } }
        }
      }
    },
    "missing": {
      "type": "object",
      "required": ["text", "position", "function"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 20 },
        "position": { "type": "integer", "minimum": 0, "maximum": 6, "description": "0 = before sentence 1; k = after sentence k." },
        "function": { "type": "string", "minLength": 10, "description": "The job the missing sentence does at its true slot: reason, example, turn, qualification, landing…" }
      }
    },
    "question": {
      "type": "object",
      "required": ["stem", "options", "option_positions", "correct"],
      "additionalProperties": false,
      "properties": {
        "stem": { "type": "string", "minLength": 10 },
        "options": { "type": "object", "required": ["A", "B", "C", "D"], "additionalProperties": false,
          "properties": { "A": { "type": "string", "minLength": 5 }, "B": { "type": "string", "minLength": 5 }, "C": { "type": "string", "minLength": 5 }, "D": { "type": "string", "minLength": 5 } } },
        "option_positions": { "type": "object", "required": ["A", "B", "C", "D"], "additionalProperties": false,
          "properties": { "A": { "type": "integer", "minimum": 0, "maximum": 6 }, "B": { "type": "integer", "minimum": 0, "maximum": 6 }, "C": { "type": "integer", "minimum": 0, "maximum": 6 }, "D": { "type": "integer", "minimum": 0, "maximum": 6 } } },
        "correct": { "enum": ["A", "B", "C", "D"] }
      }
    },
    "explanation": {
      "type": "object",
      "required": ["correct_reasoning", "clue_before", "clue_after", "distractors", "method"],
      "additionalProperties": false,
      "properties": {
        "correct_reasoning": { "type": "string", "minLength": 60 },
        "clue_before": { "type": ["string", "null"], "minLength": 15, "description": "What in the sentence BEFORE the slot demands the missing sentence next (null when the slot opens the paragraph)." },
        "clue_after": { "type": ["string", "null"], "minLength": 15, "description": "What in the sentence AFTER the slot depends on the missing sentence (null when the slot closes the paragraph)." },
        "distractors": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "object", "required": ["option", "trap_type", "why_wrong", "seductive_element"], "additionalProperties": false,
            "properties": {
              "option": { "enum": ["A", "B", "C", "D"] },
              "trap_type": { "enum": ["wrong_reference_target", "local_fit_global_break", "topic_match_function_mismatch", "premature_conclusion", "redundant_restatement", "scope_jump", "contradicts_neighbour", "stance_shift", "wrong_connective", "tense_break", "new_topic_introduced", "right_idea_wrong_position", "summary_where_development_needed", "attractive_generality"] },
              "why_wrong": { "type": "string", "minLength": 30 },
              "seductive_element": { "type": "string", "minLength": 10 }
            } }
        },
        "method": { "type": "string", "minLength": 40, "description": "The reusable rule: how an expert finds the slot on any placement item." }
      }
    },
    "mentor": {
      "type": "object",
      "required": ["challenge", "takeaway"],
      "additionalProperties": false,
      "properties": {
        "challenge": { "type": "string", "minLength": 20 },
        "takeaway": { "type": "string", "minLength": 20 }
      }
    }
  }
}
