{
  "$id": "twin.schema.v1",
  "title": "CAT OS Confusable-twins bundle, schema v1",
  "description": "Commonly confused word pairs and triples from one section letter of the owner's reference list 7 in 99_REFERENCE/ ('**Abdicate/Abrogate** — Abdicate means … Abrogate means …'). Generated by tools/build-lexicon.mjs. `words` keep their source casing; `explanation` is the full original text after the dash, transcribed faithfully. `senses` is a purely mechanical split of that explanation: when every word owns exactly one sentence of the form '<Word> means / is / are / was / were / refers to …', each sense is that sentence minus its lead-in and `split` is true; otherwise every sense carries the whole explanation and `split` is false — nothing is ever rewritten.",
  "type": "object",
  "required": ["schema_version", "meta", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },

    "meta": {
      "type": "object",
      "required": [
        "id", "type", "version", "status", "letter", "title",
        "entry_count", "source", "date_added", "batch_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "pattern": "^twin-[a-z]$" },
        "type":    { "const": "twin" },
        "version": { "type": "integer", "minimum": 1 },
        "status":  { "enum": ["draft", "review", "accepted", "rejected", "retired"] },
        "letter":  { "type": "string", "pattern": "^[A-Z]$",
          "description": "The source section heading ('## A')." },
        "title":   { "type": "string", "minLength": 1 },
        "entry_count": { "type": "integer", "minimum": 1,
          "description": "Must equal entries.length (checked by twinConsistencyIssues)." },
        "source": {
          "type": "object",
          "required": ["publication", "file", "usage_note"],
          "additionalProperties": false,
          "properties": {
            "publication": { "type": "string", "minLength": 1 },
            "file":        { "type": "string", "minLength": 1 },
            "usage_note":  { "type": "string", "minLength": 1 }
          }
        },
        "date_added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "batch_id":   { "type": "string", "pattern": "^batch-twin-[0-9]{3}$" }
      }
    },

    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "words", "senses", "explanation", "split"],
        "additionalProperties": false,
        "properties": {
          "id":    { "type": "string", "pattern": "^twin-[a-z]-[0-9]{4}$" },
          "words": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "senses": {
            "type": "array",
            "minItems": 2,
            "description": "One sense per word, in the same order as `words` (checked by twinConsistencyIssues).",
            "items": {
              "type": "object",
              "required": ["word", "meaning"],
              "additionalProperties": false,
              "properties": {
                "word":    { "type": "string", "minLength": 1 },
                "meaning": { "type": "string", "minLength": 1 }
              }
            }
          },
          "explanation": { "type": "string", "minLength": 1 },
          "split": { "type": "boolean" }
        }
      }
    }
  }
}
